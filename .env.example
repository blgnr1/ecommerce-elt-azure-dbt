# ==============================================================================
# Azure ve Veritabanı Bağlantı Parametreleri (.env Şablonu)
# ==============================================================================
# Bu dosyayı kopyalayarak '.env' olarak kaydedin ve gerçek değerlerinizi yazın.
# DİKKAT: '.env' dosyasını ASLA GitHub veya sürüm kontrol sistemlerine göndermeyin!

# Azure Data Lake / Blob Storage Bağlantı Dizesi (Connection String)
AZURE_STORAGE_CONN_STR="DefaultEndpointsProtocol=https;AccountName=your_storage_account;AccountKey=your_account_key;EndpointSuffix=core.windows.net"

# Azure SQL Server Bilgileri
AZURE_SQL_SERVER="your-server-name.database.windows.net"
AZURE_SQL_DATABASE="your_database_name"
AZURE_SQL_USER="your_sql_username"
AZURE_SQL_PASSWORD="your_sql_password"
